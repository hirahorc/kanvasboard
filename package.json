{
  "name": "kanvas",
  "version": "0.0.0",
  "private": true,
  "description": "Every state of your app on one board, as static frames, each with its rules and its changelog.",
  "type": "module",
  "bin": {
    "kanvas": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
