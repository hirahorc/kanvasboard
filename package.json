{
  "name": "kanvasboard",
  "version": "0.1.0",
  "private": true,
  "description": "Every state of your app on one board, as static frames, each with its rules and its changelog.",
  "keywords": [
    "storyboard",
    "screenshots",
    "states",
    "design",
    "changelog",
    "playwright",
    "ai",
    "agents",
    "vibe-coding"
  ],
  "license": "MIT",
  "author": "Hira Muhammad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hirahorc/kanvasboard.git"
  },
  "homepage": "https://github.com/hirahorc/kanvasboard#readme",
  "bugs": "https://github.com/hirahorc/kanvasboard/issues",
  "type": "module",
  "bin": {
    "kanvas": "./dist/cli.js",
    "kanvasboard": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs/config.md",
    "kanvas.config.example.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp -R src/page dist/page && vite build",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p viewer/tsconfig.json",
    "dev:viewer": "vite",
    "prepack": "npm run build"
  },
  "dependencies": {
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.65.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
